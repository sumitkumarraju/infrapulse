# Copy to .env and fill in. NEVER commit the filled-in copy.
#
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Use the pooled connection (port 6543) for a serverless host, or the direct
# connection (5432) for a long-running server like this one.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Engineer dashboard. The server refuses to start in production with defaults.
OPERATOR_PASSWORD=
SESSION_SECRET=
DEVICE_TOKEN_SECRET=

# Where complaints are addressed. Deliberately blank — fill from the
# jurisdiction's published contacts, never a guess.
AUTHORITY_NATIONAL_EMAIL=
AUTHORITY_STATE_EMAIL=
AUTHORITY_MUNICIPAL_EMAIL=
